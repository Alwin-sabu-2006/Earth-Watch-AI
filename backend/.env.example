# EarthWatch AI Backend Environment Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# SQLite Database Path (can be migrated to PostgreSQL later via DATABASE_URL)
DATABASE_URL=sqlite:///./database/earthwatch.db

# External API Keys (Optional - System gracefully uses public endpoints or rule-based analyst if not provided)
NASA_API_KEY=DEMO_KEY
CESIUM_ION_TOKEN=
OPENWEATHER_API_KEY=
# Google Gemini API Key for EarthWatch Analyst real LLM reasoning (get one at https://aistudio.google.com/)
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
